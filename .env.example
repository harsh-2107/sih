# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Root-level environment template for the entire SIH monorepo.
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Docker Compose picks this file up automatically from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=sih_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
# Connection string used by backend (Express) and processing (FastAPI)
DATABASE_URL=postgres://postgres:postgres_password_change_me@postgres:5432/sih_db
# Host port mapped to the container's 5432 (dev only)
POSTGRES_PORT=5433

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_change_me
# Host ports (dev only — not exposed in production)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Express backend ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=super-secret-session-key-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=localhost
# URL the Express backend uses to call the FastAPI processing service
PROCESSING_API_URL=http://processing:8000

# ── Next.js frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Processing — Agent 1: LLM ─────────────────────────────────────────────────
# Use host.docker.internal to reach an Ollama instance running on the host machine.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_NAME=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
GEO_NORMALIZATION_ENABLED=true
SUTIME_ENABLED=false

# ── Processing — Agent 2: Entity Resolution ───────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
MERGE_THRESHOLD=0.70
REVIEW_THRESHOLD=0.60
HAC_LINKAGE=average

# ── Processing — Agent 3: Knowledge Graph ─────────────────────────────────────
MIN_ENTITY_CONFIDENCE=0.5
MIN_TRIPLE_CONFIDENCE=0.5
INCLUDE_PREDICTIONS=false
LINK_PREDICTION_THRESHOLD=0.85
PREDICTION_MIN_CONFIDENCE=0.70
AUTO_TRIGGER_GRAPH_BUILD=false

# ── Processing — Agent 4: GraphRAG NL ─────────────────────────────────────────
NL_LLM_PROVIDER=ollama
NL_LLM_BASE_URL=http://host.docker.internal:11434/v1
NL_LLM_MODEL_NAME=llama3.1:8b
NL_LLM_TEMPERATURE=0.1
NL_LLM_MAX_TOKENS=1024
MAX_CONTEXT_LENGTH=2000
MAX_PATH_LENGTH=3
SIMILARITY_THRESHOLD=0.6
TOP_K_RESULTS=5
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=3600

# ── Processing — host port (dev only) ─────────────────────────────────────────
PROCESSING_PORT=8000
